<local:EditorWindow xmlns="https://github.com/avaloniaui" xmlns:local="clr-namespace:CrystalStudio" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CrystalStudio.WallBrushWindow" Title="Wall Brush" Width="700" Height="610" MinWidth="530" MinHeight="500" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Theme14171D}" Foreground="{DynamicResource ThemeE5E9F0}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Wall Type" FontWeight="SemiBold" Margin="0,0,0,6" /><ComboBox x:Name="WallTypeList" SelectionChanged="SelectionChanged" AutomationProperties.Name="Wall Type"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
        <WrapPanel x:Name="FacingModes" Grid.Row="1" Margin="0,16,0,8"><RadioButton x:Name="InnerMode" Content="Inner" Foreground="{DynamicResource ThemeE5E9F0}" GroupName="Facing" IsCheckedChanged="ModeChanged" Margin="0,0,24,0" AutomationProperties.Name="Inner Wall" /><RadioButton x:Name="OuterMode" Content="Outer" Foreground="{DynamicResource ThemeE5E9F0}" GroupName="Facing" IsCheckedChanged="ModeChanged" AutomationProperties.Name="Outer Wall" /></WrapPanel>
        <Border Grid.Row="3" Background="{DynamicResource Theme252C38}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="12">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                <TextBlock Text="Single Section Preview" FontWeight="SemiBold" />
                <Image x:Name="SectionPreview" Grid.Row="1" Stretch="Uniform" Margin="0,12,0,0" RenderOptions.BitmapInterpolationMode="None" AutomationProperties.Name="Wall Section Preview" />
                <TextBlock x:Name="PreviewHint" Grid.Row="1" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" Foreground="{DynamicResource Muted}" />
            </Grid>
        </Border>
        <TextBlock x:Name="AvailabilityHint" Grid.Row="4" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,10,0,0" />
        <DockPanel Grid.Row="5" Margin="0,16,0,0" LastChildFill="False"><Button x:Name="UseBrushButton" DockPanel.Dock="Right" Content="Use Brush" IsDefault="True" Click="UseClick" Padding="18,7" /><Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Margin="0,0,8,0" Padding="18,7" /></DockPanel>
    </Grid>
</local:EditorWindow>