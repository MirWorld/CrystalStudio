<Project>
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TrimMode>partial</TrimMode>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
    <StripSymbols>true</StripSymbols>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- All application JSON contracts use source generation. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\Build\CrystalStudioAvalonia\aot\win-x64\</PublishDir>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootDescriptor Include="$(MSBuildProjectDirectory)\AotRoots.xml" />
    <!-- Native graphics DLLs are supplied by the Avalonia/SkiaSharp NuGet packages.
         Keep normal P/Invoke resolution so this standalone repository does not
         depend on the original server's NativeStaticLibrary directory. -->
  </ItemGroup>
</Project>
