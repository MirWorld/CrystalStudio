<Project>
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TrimMode>partial</TrimMode>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
    <StripSymbols>true</StripSymbols>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- All application JSON contracts use source generation. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\Build\CrystalStudioAvalonia\aot\win-x64\</PublishDir>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootDescriptor Include="$(MSBuildProjectDirectory)\AotRoots.xml" />
    <!-- Reuse the native graphics libraries used by Server.Avalonia. -->
    <DirectPInvoke Include="libHarfBuzzSharp" />
    <NativeLibrary Include="$(MSBuildProjectDirectory)\..\..\NativeStaticLibrary\x64\libHarfBuzzSharp.lib" />
    <DirectPInvoke Include="libSkiaSharp" />
    <NativeLibrary Include="$(MSBuildProjectDirectory)\..\..\NativeStaticLibrary\x64\libSkiaSharp.lib" />
    <DirectPInvoke Include="av_libglesv2" />
    <NativeLibrary Include="$(MSBuildProjectDirectory)\..\..\NativeStaticLibrary\x64\av_libglesv2.lib" />
  </ItemGroup>
</Project>
