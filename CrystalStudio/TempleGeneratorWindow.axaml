<local:EditorWindow xmlns="https://github.com/avaloniaui" xmlns:local="clr-namespace:CrystalStudio" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CrystalStudio.TempleGeneratorWindow" Title="{local:Loc GenerateDungeon_E3AFA653}" Width="1060" Height="760" MinWidth="830" MinHeight="630" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Theme14171D}" Foreground="{DynamicResource ThemeE5E9F0}">
    <Window.Resources><ResourceDictionary /></Window.Resources>
    <Grid Margin="20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock Text="{local:Loc FantasyDungeonTheme}" FontWeight="SemiBold" />
                <ComboBox x:Name="ThemeList" SelectionChanged="ThemeChanged" Margin="0,6,0,12" AutomationProperties.Name="{local:Loc FantasyDungeonTheme}">
                    <ComboBoxItem Content="{local:Loc ClassicDungeonTheme}" />
                    <ComboBoxItem Content="{local:Loc CelestialPalaceTheme}" />
                    <ComboBoxItem Content="{local:Loc AbyssalReefTheme}" />
                    <ComboBoxItem Content="{local:Loc AlienPlanetTheme}" />
                </ComboBox>
                <TextBlock x:Name="ThemeDescription" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,14" />
                <TextBlock Text="{local:Loc DungeonType_34009401}" FontWeight="SemiBold" />
                <ComboBox x:Name="DungeonTypeList" SelectionChanged="SettingsChanged" Margin="0,6,0,18" AutomationProperties.Name="{local:Loc DungeonType_34009401}" />
                <TextBlock Text="{local:Loc Style_7E744141}" FontWeight="SemiBold" />
                <ComboBox x:Name="TempleList" SelectionChanged="SettingsChanged" Margin="0,6,0,18" AutomationProperties.Name="{local:Loc DungeonStyle_142FF938}" />
                <TextBlock><Run Text="{local:Loc RoomCount_1C861272}" /><Run Text=": " /><Run Text="{Binding ElementName=RoomsSlider, Path=Value, StringFormat={}{0:0}}" /></TextBlock>
                <Slider x:Name="RoomsSlider" Minimum="1" Maximum="30" Value="12" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SettingsChanged" Margin="0,6,0,18" AutomationProperties.Name="{local:Loc RoomCount_1C861272}" />
                <TextBlock x:Name="RoomSizeText"><Run Text="{local:Loc RoomSize_05364AD8}" /><Run Text=": " /><Run Text="{Binding ElementName=SizeSlider, Path=Value, StringFormat={}{0:0}}" /></TextBlock>
                <Slider x:Name="SizeSlider" Minimum="0" Maximum="5" Value="5" Ticks="0,3,4,5" IsSnapToTickEnabled="True" ValueChanged="SettingsChanged" Margin="0,6,0,18" AutomationProperties.Name="{local:Loc RoomSize_05364AD8}" />
                <TextBlock Text="{local:Loc CorridorWidth_6B297440}" />
                <ComboBox x:Name="WidthList" SelectionChanged="SettingsChanged" Margin="0,6,0,18" AutomationProperties.Name="{local:Loc CorridorWidth_6B297440}"><ComboBoxItem Content="{local:Loc Narrow_BA227109}" /><ComboBoxItem Content="{local:Loc Wide_147170E7}" /></ComboBox>
                <TextBlock><Run Text="{local:Loc Amountofdoors_7B539A2E}" /><Run Text="{Binding ElementName=DoorCountSlider, Path=Value, StringFormat={}{0:0}}" /></TextBlock>
                <Slider x:Name="DoorCountSlider" Minimum="0" Maximum="32" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SettingsChanged" Margin="0,6,0,6" AutomationProperties.Name="{local:Loc Amountofdoors_DC5C3D82}" />
                <TextBlock x:Name="DoorHint" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,18" />
            </StackPanel></ScrollViewer>
            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                <TextBlock Text="{local:Loc Seed_367EF06B}" />
                <DockPanel Margin="0,6,0,0"><Button DockPanel.Dock="Right" Content="{local:Loc Shuffle_317CB3A7}" Click="ShuffleClick" Padding="10,4" Margin="8,0,0,0" /><TextBox x:Name="SeedBox" Text="1" TextChanged="SettingsChanged" AutomationProperties.Name="{local:Loc DungeonSeed_047F4F3C}" /></DockPanel>
            </StackPanel>
        </Grid>
        <Border Grid.Column="2" Background="#20272D" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="12">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                <DockPanel><CheckBox x:Name="DetailToggle" DockPanel.Dock="Right" Content="{local:Loc DetailView_9FF91837}" IsCheckedChanged="SettingsChanged" Foreground="{DynamicResource ThemeE5E9F0}" /><TextBlock Text="{local:Loc DungeonPreview_61E4CAD2}" FontWeight="SemiBold" /></DockPanel>
                <Image x:Name="PreviewImage" Grid.Row="1" Stretch="Uniform" Margin="0,12,0,0" RenderOptions.BitmapInterpolationMode="None" AutomationProperties.Name="{local:Loc GeneratedDungeonPreview_EE2C0CDA}" />
                <TextBlock x:Name="PreviewHint" Grid.Row="1" Text="{local:Loc LoadingDungeonArtwork_612948E0}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" Foreground="{DynamicResource Muted}" />
            </Grid>
        </Border>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0">
            <TextBlock x:Name="FeedbackText" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" />
        </StackPanel>
        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,16,0,0" LastChildFill="False">
            <Button x:Name="ApplyButton" DockPanel.Dock="Right" Content="{local:Loc ApplyDungeon_147E9FFC}" IsEnabled="False" Click="ApplyClick" Padding="18,7" />
            <Button DockPanel.Dock="Right" Content="{local:Loc Cancel_19766ED6}" IsCancel="True" Margin="0,0,8,0" Padding="18,7" />
            <Button x:Name="RandomizeButton" DockPanel.Dock="Left" Content="{local:Loc Randomize_1F7483C8}" IsEnabled="False" Click="RandomizeClick" Padding="18,7" />
        </DockPanel>
    </Grid>
</local:EditorWindow>