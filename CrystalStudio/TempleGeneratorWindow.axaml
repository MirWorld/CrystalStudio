<local:EditorWindow xmlns="https://github.com/avaloniaui" xmlns:local="clr-namespace:CrystalStudio" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CrystalStudio.TempleGeneratorWindow" Title="Generate Dungeon" Width="1060" Height="760" MinWidth="830" MinHeight="630" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Theme14171D}" Foreground="{DynamicResource ThemeE5E9F0}">
    <Window.Resources><ResourceDictionary /></Window.Resources>
    <Grid Margin="20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock Text="Dungeon Type" FontWeight="SemiBold" />
                <ComboBox x:Name="DungeonTypeList" SelectionChanged="SettingsChanged" Margin="0,6,0,18" AutomationProperties.Name="Dungeon Type" />
                <TextBlock Text="Style" FontWeight="SemiBold" />
                <ComboBox x:Name="TempleList" SelectionChanged="SettingsChanged" Margin="0,6,0,18" AutomationProperties.Name="Dungeon Style" />
                <TextBlock />
                <Slider x:Name="RoomsSlider" Minimum="1" Maximum="30" Value="12" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SettingsChanged" Margin="0,6,0,18" AutomationProperties.Name="Room Count" />
                <TextBlock x:Name="RoomSizeText" />
                <Slider x:Name="SizeSlider" Minimum="0" Maximum="5" Value="5" Ticks="0,3,4,5" IsSnapToTickEnabled="True" ValueChanged="SettingsChanged" Margin="0,6,0,18" AutomationProperties.Name="Room Size" />
                <TextBlock Text="Corridor Width" />
                <ComboBox x:Name="WidthList" SelectionChanged="SettingsChanged" Margin="0,6,0,18" AutomationProperties.Name="Corridor Width"><ComboBoxItem Content="Narrow" /><ComboBoxItem Content="Wide" /></ComboBox>
                <TextBlock><Run Text="Amount of doors · " /><Run Text="{Binding ElementName=DoorCountSlider, Path=Value, StringFormat={}{0:0}}" /></TextBlock>
                <Slider x:Name="DoorCountSlider" Minimum="0" Maximum="32" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SettingsChanged" Margin="0,6,0,6" AutomationProperties.Name="Amount of doors" />
                <TextBlock x:Name="DoorHint" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,18" />
            </StackPanel></ScrollViewer>
            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                <TextBlock Text="Seed" />
                <DockPanel Margin="0,6,0,0"><Button DockPanel.Dock="Right" Content="Shuffle" Click="ShuffleClick" Padding="10,4" Margin="8,0,0,0" /><TextBox x:Name="SeedBox" Text="1" TextChanged="SettingsChanged" AutomationProperties.Name="Dungeon Seed" /></DockPanel>
            </StackPanel>
        </Grid>
        <Border Grid.Column="2" Background="#20272D" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="12">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                <DockPanel><CheckBox x:Name="DetailToggle" DockPanel.Dock="Right" Content="Detail View" IsCheckedChanged="SettingsChanged" Foreground="{DynamicResource ThemeE5E9F0}" /><TextBlock Text="Dungeon Preview" FontWeight="SemiBold" /></DockPanel>
                <Image x:Name="PreviewImage" Grid.Row="1" Stretch="Uniform" Margin="0,12,0,0" RenderOptions.BitmapInterpolationMode="None" AutomationProperties.Name="Generated Dungeon Preview" />
                <TextBlock x:Name="PreviewHint" Grid.Row="1" Text="Loading Dungeon Artwork…" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" Foreground="{DynamicResource Muted}" />
            </Grid>
        </Border>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0">
            <TextBlock x:Name="FeedbackText" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" />
        </StackPanel>
        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,16,0,0" LastChildFill="False">
            <Button x:Name="ApplyButton" DockPanel.Dock="Right" Content="Apply Dungeon" IsEnabled="False" Click="ApplyClick" Padding="18,7" />
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Margin="0,0,8,0" Padding="18,7" />
            <Button x:Name="RandomizeButton" DockPanel.Dock="Left" Content="Randomize" IsEnabled="False" Click="RandomizeClick" Padding="18,7" />
        </DockPanel>
    </Grid>
</local:EditorWindow>