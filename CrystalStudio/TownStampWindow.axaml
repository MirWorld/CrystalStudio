<local:EditorWindow xmlns="https://github.com/avaloniaui" xmlns:local="clr-namespace:CrystalStudio" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CrystalStudio.TownStampWindow" Title="{local:Loc GenerateTown_5B3BA5F5}" Width="1060" Height="760" MinWidth="850" MinHeight="610" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Theme14171D}" Foreground="{DynamicResource ThemeE5E9F0}">
    <Grid Margin="20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid><Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock Text="{local:Loc TownType_204D4060}" FontWeight="SemiBold" /><ComboBox x:Name="TypeList" Margin="0,6,0,14" SelectionChanged="SettingsChanged" AutomationProperties.Name="{local:Loc TownType_204D4060}" />
                <TextBlock Text="{local:Loc StreetLayout_1CF64F55}" FontWeight="SemiBold" /><ComboBox x:Name="LayoutList" Margin="0,6,0,14" SelectionChanged="SettingsChanged" AutomationProperties.Name="{local:Loc StreetLayout_1CF64F55}" SelectedValueBinding="{Binding Tag}"><ComboBoxItem Content="{local:Loc HighStreetVillage_CF87A74C}" Tag="{x:Static local:TownLayout.HighStreet}" /><ComboBoxItem Content="{local:Loc PlannedCrossroads_38B7E94F}" Tag="{x:Static local:TownLayout.Crossroads}" /><ComboBoxItem Content="{local:Loc MarketSquare_B518A66E}" Tag="{x:Static local:TownLayout.MarketSquare}" /><ComboBoxItem Content="{local:Loc VillageGreen_1260062E}" Tag="{x:Static local:TownLayout.VillageGreen}" /><ComboBoxItem Content="{local:Loc TownBlocks_880CD4E1}" Tag="{x:Static local:TownLayout.Grid}" /><ComboBoxItem Content="{local:Loc WindingHighStreet_B6E6EDA4}" Tag="{x:Static local:TownLayout.WindingStreet}" /><ComboBoxItem Content="{local:Loc ForkedVillageLanes_D12E40B5}" Tag="{x:Static local:TownLayout.ForkedLanes}" /><ComboBoxItem Content="{local:Loc LinkedHamlets_FDB265F5}" Tag="{x:Static local:TownLayout.LinkedHamlets}" /></ComboBox>
                <TextBlock Text="{local:Loc TownSizeMapCells_661A6D17}" FontWeight="SemiBold" /><ComboBox x:Name="SizeList" Margin="0,6,0,14" SelectionChanged="SettingsChanged" AutomationProperties.Name="{local:Loc TownSize_F19E1D29}"><ComboBoxItem Content="{local:Loc Small6464_12D80795}" Tag="64" /><ComboBoxItem Content="{local:Loc Medium9696_53FDB509}" Tag="96" /><ComboBoxItem Content="{local:Loc Large144144_4BCBC3A5}" Tag="144" /><ComboBoxItem Content="{local:Loc VeryLarge192192_ED9A26BC}" Tag="192" /></ComboBox>
                <TextBlock><Run Text="{local:Loc BuildingAmount_E982A0A4}" /><Run Text="{Binding ElementName=DensitySlider, Path=Value, StringFormat=F0}" /><Run Text="%" /></TextBlock>
                <Slider x:Name="DensitySlider" Minimum="25" Maximum="90" Value="65" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,6,0,14" ValueChanged="SettingsChanged" AutomationProperties.Name="{local:Loc BuildingAmount_0A825F9E}" />
                <TextBlock><Run Text="{local:Loc MinimumGap_AEFBA021}" /><Run Text="{Binding ElementName=GapSlider, Path=Value, StringFormat=F0}" /><Run Text="{local:Loc Cells_D8B264EC}" /></TextBlock>
                <Slider x:Name="GapSlider" Minimum="2" Maximum="8" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,14" ValueChanged="SettingsChanged" AutomationProperties.Name="{local:Loc BuildingGap_F833502B}" />
                <TextBlock><Run Text="{local:Loc WallFenceChance_5F74B316}" /><Run Text="{Binding ElementName=WallChanceSlider, Path=Value, StringFormat=F0}" /><Run Text="%" /></TextBlock>
                <Slider x:Name="WallChanceSlider" Minimum="0" Maximum="100" Value="40" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,6,0,14" ValueChanged="SettingsChanged" AutomationProperties.Name="{local:Loc WallandFenceChance_F69D2FC7}" ToolTip.Tip="{local:Loc ChancetoEncloseaGardenNeighbourhoodorWholeSettlementwithMatchingG_53F4A504}" />
                <CheckBox x:Name="GroundToggle" Content="{local:Loc IncludeTownGroundandStreets_486A648B}" IsChecked="True" Margin="0,0,0,12" IsCheckedChanged="SettingsChanged" />
                <TextBlock Text="{local:Loc GroundandPaths_DB378EA3}" FontWeight="SemiBold" /><ComboBox x:Name="PathList" Margin="0,6,0,14" SelectionChanged="SettingsChanged" IsEnabled="{Binding ElementName=GroundToggle, Path=IsChecked}" SelectedValueBinding="{Binding Style}" AutomationProperties.Name="{local:Loc GroundandPaths_DB378EA3}" ToolTip.Tip="{local:Loc CompatibleGroundandPathTileswithMatchingBlendedEdges_E1E5ADA4}" />
                <TextBlock Text="{local:Loc Decorations_5A02B053}" FontWeight="SemiBold" /><ComboBox x:Name="DecorationList" Margin="0,6,0,14" SelectionChanged="SettingsChanged" AutomationProperties.Name="{local:Loc DecorationAmount_2A06CCD6}"><ComboBoxItem Content="{local:Loc None_DC937B59}" /><ComboBoxItem Content="{local:Loc Sparse_92E5C493}" /><ComboBoxItem Content="{local:Loc Moderate_5C42AFC7}" /><ComboBoxItem Content="{local:Loc DetailedScenes}" /></ComboBox>
                <CheckBox x:Name="GreeneryToggle" Content="{local:Loc IncludeTreesandGardens_41510CB6}" IsChecked="True" Margin="0,0,0,16" IsCheckedChanged="SettingsChanged" />
            </StackPanel></ScrollViewer>
            <StackPanel Grid.Row="1" Margin="0,16,0,0"><TextBlock Text="{local:Loc Seed_367EF06B}" /><DockPanel Margin="0,6,0,0"><Button DockPanel.Dock="Right" Content="{local:Loc Shuffle_317CB3A7}" Click="ShuffleClick" ToolTip.Tip="{local:Loc RandomizeOnlytheSeed_B0D48D6E}" Padding="10,4" Margin="8,0,0,0" /><TextBox x:Name="SeedBox" Text="1" TextChanged="SettingsChanged" AutomationProperties.Name="{local:Loc TownSeed_68D0A77E}" /></DockPanel></StackPanel>
        </Grid>
        <Border Grid.Column="2" Background="{DynamicResource Theme252C38}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="12">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                <DockPanel><CheckBox x:Name="DetailToggle" DockPanel.Dock="Right" Content="{local:Loc CentreDetail_E3824490}" IsCheckedChanged="DetailChanged" /><TextBlock Text="{local:Loc TownPreview_9A6FA8CB}" FontWeight="SemiBold" /></DockPanel>
                <Image x:Name="PreviewImage" Grid.Row="1" Stretch="Uniform" Margin="0,12,0,0" RenderOptions.BitmapInterpolationMode="None" AutomationProperties.Name="{local:Loc GeneratedTownPreview_87FBD88D}" />
                <TextBlock x:Name="PreviewHint" Grid.Row="1" Text="{local:Loc PreparingTownArtwork_2DF7ECDD}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" Foreground="{DynamicResource Muted}" />
            </Grid>
        </Border>
        <TextBlock x:Name="FeedbackText" Grid.Row="1" Grid.ColumnSpan="3" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,14,0,0" />
        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,16,0,0">
            <Button x:Name="RandomizeButton" DockPanel.Dock="Left" Content="{local:Loc Randomize_1F7483C8}" IsEnabled="False" Click="RandomizeClick" Padding="18,7" ToolTip.Tip="{local:Loc RandomizeAllTownSettingsandtheSeed_DE8C0850}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{local:Loc Cancel_19766ED6}" IsCancel="True" Padding="18,7" Margin="0,0,8,0" /><Button x:Name="UseButton" Content="{local:Loc UseTown_5216C997}" IsEnabled="False" Click="UseClick" Padding="18,7" /></StackPanel>
        </DockPanel>
    </Grid>
</local:EditorWindow>