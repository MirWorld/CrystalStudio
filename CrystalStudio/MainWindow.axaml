<local:EditorWindow xmlns="https://github.com/avaloniaui" xmlns:local="clr-namespace:CrystalStudio" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CrystalStudio.MainWindow" Foreground="{DynamicResource ThemeE5E9F0}" Background="{DynamicResource Theme14171D}" FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True" Title="Crystal Studio — Map Editor" Width="1500" Height="950" MinWidth="1100" MinHeight="720" WindowStartupLocation="CenterScreen">
<Window.Resources><ResourceDictionary /></Window.Resources>
<Grid>
<Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="0" /><RowDefinition Height="48" /><RowDefinition /><RowDefinition Height="30" /></Grid.RowDefinitions>
<Border Background="{DynamicResource Theme1C2028}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><DockPanel Margin="18,0"><TextBlock DockPanel.Dock="Right" Text="Crystal Studio" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" /><Menu VerticalAlignment="Center" Background="Transparent" Foreground="{DynamicResource ThemeE5E9F0}"><MenuItem Header="_File"><MenuItem x:Name="NewButton" Header="_New Map…" Click="NewClick" InputGesture="Ctrl+N" /><MenuItem x:Name="OpenButton" Header="_Open Map…" Click="OpenClick" InputGesture="Ctrl+O" /><MenuItem x:Name="OpenRecentButton" Header="Open _Recent" /><MenuItem x:Name="SaveButton" Header="_Save Map" Click="SaveClick" InputGesture="Ctrl+S" /><MenuItem x:Name="SaveAsButton" Header="Save _As…" Click="SaveAsClick" InputGesture="Ctrl+Shift+S" /><MenuItem x:Name="ExportMinimapButton" Header="Export _Minimap…" Click="ExportMinimapClick" /><Separator /><MenuItem x:Name="NewStampButton" Header="New _Stamp" Click="NewStampClick" InputGesture="Ctrl+Shift+N" /><MenuItem x:Name="ImportButton" Header="_Import Stamp…" Click="StampClick" /><MenuItem x:Name="ExportButton" Header="_Export Selection…" Click="ExportClick" /><Separator /><MenuItem Header="E_xit" Click="ExitClick" /></MenuItem><MenuItem Header="_Edit"><MenuItem x:Name="UndoButton" Header="_Undo" Click="UndoClick" InputGesture="Ctrl+Z" /><MenuItem x:Name="RedoButton" Header="_Redo" Click="RedoClick" InputGesture="Ctrl+Shift+Z" /><Separator /><MenuItem x:Name="FillButton" Header="_Fill Selection" Click="FillClick" /><Separator /><MenuItem Header="_Settings…" Click="SettingsClick" /></MenuItem><MenuItem x:Name="ViewMenu" Header="_View"><MenuItem x:Name="DarkModeToggle" Header="_Dark Mode" ToggleType="CheckBox" Click="DarkModeClick" ToolTip.Tip="Override Windows with Dark Colours. Uncheck to Follow Windows." /><Separator /><MenuItem x:Name="GridToggle" Header="Cell _Grid" InputGesture="G" ToggleType="CheckBox" IsChecked="True" Click="ViewChanged" /><Separator /><MenuItem x:Name="MapLightingMenu" Header="Map _Lighting" ToolTip.Tip="Preview Crystal Time of Day. Map Lights Use Values 1–9 on Foreground Cells."><MenuItem x:Name="DawnDuskLighting" Header="_Dawn/Dusk" Tag="DawnDusk" ToggleType="CheckBox" Click="LightingClick" /><MenuItem x:Name="DayLighting" Header="_Day" Tag="Day" ToggleType="CheckBox" IsChecked="True" Click="LightingClick" /><MenuItem x:Name="NightLighting" Header="_Night" Tag="Night" ToggleType="CheckBox" Click="LightingClick" /></MenuItem><MenuItem x:Name="DoorsOpenToggle" Header="_Open Doors" ToggleType="CheckBox" Click="ViewChanged" ToolTip.Tip="Checked: Preview All Doors Open. Unchecked: Preview All Doors Closed." /><Separator /><MenuItem Header="Zoom _In" Click="ZoomInClick" /><MenuItem Header="Zoom _Out" Click="ZoomOutClick" /><MenuItem Header="_Actual Size (100%)" Click="ResetZoomClick" /><MenuItem Header="_Fit Map" Click="FitClick" /></MenuItem><MenuItem Header="_Tools"><MenuItem x:Name="TownStampMenuButton" Header="Generate _Town…" Click="TownStampClick" /><MenuItem x:Name="GenerateTerrainButton" Header="_Generate Terrain…" Click="GenerateTerrainClick" /><MenuItem x:Name="GenerateProvinceButton" Header="Generate _Province…" Click="GenerateProvinceClick" /><MenuItem x:Name="GenerateTempleButton" Header="Generate _Dungeon…" Click="GenerateTempleClick" /><Separator /><MenuItem x:Name="IdentifyButton" Header="_Identify Objects…" Click="IdentifyStampsClick" /></MenuItem><MenuItem Header="_Help"><MenuItem Header="Keyboard _Shortcuts…" Click="ShortcutsClick" InputGesture="F1" /></MenuItem></Menu></DockPanel></Border>
<Border Grid.Row="2" Background="{DynamicResource Theme1C2028}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><Grid Margin="6,4"><WrapPanel x:Name="SizeControls" VerticalAlignment="Center"><Slider x:Name="BrushSize" Minimum="3" Maximum="31" Value="3" TickFrequency="2" IsSnapToTickEnabled="True" Width="78" HorizontalAlignment="Center" VerticalAlignment="Center" ValueChanged="BrushChanged" ToolTip.Tip="Centred Brush Footprint · [ And ] to Resize" /><Border Background="{DynamicResource Theme293242}" CornerRadius="4" Padding="5,2" Margin="0,4,0,0" HorizontalAlignment="Center"><TextBlock x:Name="BrushSizeLabel" Text="3×3" MinWidth="35" TextAlignment="Center" FontWeight="SemiBold" /></Border><Button x:Name="SpecialBrushSettingsButton" Content="Special Settings…" Click="SpecialBrushClick" Theme="{StaticResource QuietButton}" IsVisible="False" /></WrapPanel><WrapPanel x:Name="TownControls" IsVisible="False"><Button x:Name="TownSettingsButton" Content="Town Settings…" Click="TownStampClick" Theme="{StaticResource QuietButton}" /><TextBlock x:Name="TownBrushLabel" VerticalAlignment="Center" Margin="6,0,0,0" /></WrapPanel><WrapPanel x:Name="WallControls" IsVisible="False" VerticalAlignment="Center"><Button x:Name="WallSettingsButton" Content="Wall Settings…" Click="WallBrushClick" Theme="{StaticResource QuietButton}" /><TextBlock x:Name="WallBrushLabel" VerticalAlignment="Center" Margin="6,0,0,0" /><CheckBox x:Name="WallEraseToggle" Content="Remove" Margin="8,0,0,0" VerticalAlignment="Center" IsCheckedChanged="WallEraseChanged" ToolTip.Tip="Remove a Wall Section and Reconnect Its Neighbours. Shift Also Removes." /></WrapPanel><WrapPanel x:Name="PickupActions" VerticalAlignment="Center" IsVisible="False"><Button x:Name="DeleteStampButton" Content="Delete" Click="DeleteStampClick" Theme="{StaticResource QuietButton}" ToolTip.Tip="Delete the Picked Stamp · Delete" /><Button x:Name="CancelPickupButton" Content="Cancel" Click="CancelPickupClick" Theme="{StaticResource QuietButton}" ToolTip.Tip="Cancel Pickup · Escape" /></WrapPanel></Grid></Border>
<Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition /><ColumnDefinition Width="5" /><ColumnDefinition Width="360" MinWidth="300" MaxWidth="480" /></Grid.ColumnDefinitions>
<Border Background="{DynamicResource Theme1C2028}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"><local:ResponsivePanel x:Name="ToolPanel" ItemMinWidth="36" Margin="0,12,0,0">
<RadioButton Theme="{StaticResource ToolButton}" Tag="Brush" AutomationProperties.Name="Brush" IsChecked="True" Click="ToolClick" ToolTip.Tip="Brush · B&#10;Paint Complete Terrain Patterns"><Viewbox Width="16" Height="16" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="M 14,3 C 17,0 21,0 22,2 C 23,4 20,8 17,11 L 12,16 L 8,12 Z M 7,13 L 11,17 C 11,21 7,23 2,22 C 4,20 2,17 5,15 Z" /><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Data="M 8,11 L 13,16" /></Canvas></Viewbox></RadioButton>
<RadioButton Theme="{StaticResource ToolButton}" Tag="Pencil" AutomationProperties.Name="Pencil" Click="ToolClick" ToolTip.Tip="Pencil · P&#10;Place One Exact Tile"><TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="16" HorizontalAlignment="Center" /></RadioButton>
<RadioButton x:Name="BucketToolButton" Theme="{StaticResource ToolButton}" Tag="Bucket" AutomationProperties.Name="Fill" Click="ToolClick" ToolTip.Tip="Fill · F&#10;Fill Connected Matching Tiles / Smtiles or Apply Low/High Collisions"><Viewbox Width="16" Height="16" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" StrokeJoin="Round" Data="M 3,12 L 11,4 L 20,13 L 12,21 Z M 3,12 L 19,12 M 8,7 L 5,4 C 3,2 6,0 8,2 L 13,7" /><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="M 4,13 L 18,13 L 12,19 Z M 21,14 C 21,14 18.5,17.5 18.5,19 C 18.5,22.3 23.5,22.3 23.5,19 C 23.5,17.5 21,14 21,14 Z" /></Canvas></Viewbox></RadioButton>
<RadioButton Theme="{StaticResource ToolButton}" Tag="Eraser" AutomationProperties.Name="Eraser" Click="ToolClick" ToolTip.Tip="Eraser · E&#10;Erase the Active Layer"><TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="16" HorizontalAlignment="Center" /></RadioButton>
<RadioButton Theme="{StaticResource ToolButton}" Tag="Select" AutomationProperties.Name="Select" Click="ToolClick" ToolTip.Tip="Select · M&#10;Drag to Select a Region"><TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="16" HorizontalAlignment="Center" /></RadioButton>

<RadioButton Theme="{StaticResource ToolButton}" Tag="Stamp" AutomationProperties.Name="Stamp" Click="ToolClick" ToolTip.Tip="Stamp · O&#10;Place an Imported .X Object"><TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="16" HorizontalAlignment="Center" /></RadioButton>
<RadioButton Theme="{StaticResource ToolButton}" Tag="Pickup" AutomationProperties.Name="Pickup" Click="ToolClick" ToolTip.Tip="Pickup · V&#10;Click a Remembered Stamp, Then Click to Move&#10;Delete Removes It · Escape Cancels"><TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="16" HorizontalAlignment="Center" /></RadioButton>
<RadioButton x:Name="CloneToolButton" Theme="{StaticResource ToolButton}" Tag="Clone" AutomationProperties.Name="Clone" Click="ToolClick" ToolTip.Tip="Clone · K&#10;Click a Remembered Stamp, Then Click to Place a Copy&#10;Escape Cancels"><TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="16" HorizontalAlignment="Center" /></RadioButton>
<RadioButton x:Name="WallToolButton" Theme="{StaticResource ToolButton}" Tag="Wall" AutomationProperties.Name="Wall" Click="WallBrushClick" ToolTip.Tip="Wall · H&#10;Choose a Wall Type, Inner or Outer, and Preview a Section&#10;Shift Removes Sections"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Data="M 2,5 L 22,5 L 22,20 L 2,20 Z M 2,10 L 22,10 M 2,15 L 22,15 M 8,5 L 8,10 M 16,5 L 16,10 M 5,10 L 5,15 M 13,10 L 13,15 M 20,10 L 20,15 M 8,15 L 8,20 M 16,15 L 16,20" /></Canvas></Viewbox></RadioButton>
<RadioButton x:Name="SpecialBrushToolButton" Theme="{StaticResource ToolButton}" Tag="SpecialBrush" AutomationProperties.Name="Special Brush" Click="SpecialBrushClick" ToolTip.Tip="Special Brush · T&#10;Choose a Special Brush Type and Configure Its Settings"><Viewbox Width="16" Height="16" HorizontalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="M 3,18 L 16,5 L 19,8 L 6,21 Z M 3,1 L 4,4 L 7,5 L 4,6 L 3,9 L 2,6 L 0,5 L 2,4 Z M 19,12 L 20,15 L 23,16 L 20,17 L 19,20 L 18,17 L 15,16 L 18,15 Z" /></Canvas></Viewbox></RadioButton>
</local:ResponsivePanel></Border>
<Grid Grid.Column="1" ClipToBounds="True"><local:MapViewport x:Name="Viewport" />
<Border Background="{DynamicResource ThemeED1C2028}" BorderBrush="{DynamicResource Theme3B4555}" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18" Padding="3"><StackPanel Orientation="Horizontal"><Button Content="−" Click="ZoomOutClick" Theme="{StaticResource QuietButton}" Padding="10,4" ToolTip.Tip="Zoom Out" /><Button x:Name="ZoomLabel" Content="100%" Click="ResetZoomClick" Theme="{StaticResource QuietButton}" Padding="9,4" MinWidth="60" ToolTip.Tip="Reset To 100%" /><Button Content="+" Click="ZoomInClick" Theme="{StaticResource QuietButton}" Padding="10,4" ToolTip.Tip="Zoom In" /><Border Width="1" Background="{DynamicResource Line}" Margin="5" /><Button Content="Fit Map" Click="FitClick" Theme="{StaticResource QuietButton}" Padding="10,4" /></StackPanel></Border></Grid>
<GridSplitter Grid.Column="2" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Theme252C36}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ToolTip.Tip="Drag to Resize the Asset Panel" />
<Border Grid.Column="3" Background="{DynamicResource Theme1C2028}"><Grid Margin="16,14"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<StackPanel x:Name="LayersContent">
  <ListBox x:Name="LayerList" SelectedIndex="0" SelectionChanged="LayerChanged" ItemContainerTheme="{StaticResource LayerRow}" Padding="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" ToolTip.Tip="Select a Row to Choose the Editing Layer. Use Its Eye to Toggle Visibility." AutomationProperties.Name="Editing Layer">
    <ListBox.ItemsPanel><ItemsPanelTemplate><local:ResponsivePanel ItemMinWidth="160" /></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBoxItem ToolTip.Tip="Ground Tiles · 2×2 Cells">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <CheckBox x:Name="GroundVisible" IsChecked="True" Theme="{StaticResource LayerVisibility}" IsCheckedChanged="ViewChanged" ToolTip.Tip="Show / Hide Ground Tiles" AutomationProperties.Name="Ground Tiles Visibility" />
        <TextBlock Grid.Column="1" Text="Ground Tiles" VerticalAlignment="Center" />
      </Grid>
    </ListBoxItem>
    <ListBoxItem ToolTip.Tip="Middle Tiles · 1×1 Cells">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <CheckBox x:Name="MiddleVisible" IsChecked="True" Theme="{StaticResource LayerVisibility}" IsCheckedChanged="ViewChanged" ToolTip.Tip="Show / Hide Middle Tiles" AutomationProperties.Name="Middle Tiles Visibility" />
        <TextBlock Grid.Column="1" Text="Middle Tiles" VerticalAlignment="Center" />
      </Grid>
    </ListBoxItem>
    <ListBoxItem ToolTip.Tip="Objects · Foreground Sprites">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <CheckBox x:Name="ObjectsVisible" IsChecked="True" Theme="{StaticResource LayerVisibility}" IsCheckedChanged="ViewChanged" ToolTip.Tip="Show / Hide Objects" AutomationProperties.Name="Objects Visibility" />
        <TextBlock Grid.Column="1" Text="Objects" VerticalAlignment="Center" />
      </Grid>
    </ListBoxItem>
    <ListBoxItem ToolTip.Tip="Low Collisions · Pink · Paint to Apply, Erase or Delete Selection to Remove">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <CheckBox x:Name="LowCollisionVisible" IsChecked="False" IsCheckedChanged="ViewChanged" Theme="{StaticResource LayerVisibility}" ToolTip.Tip="Show / Hide Low Collisions" AutomationProperties.Name="Low Collisions Visibility" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Width="7" Height="7" CornerRadius="2" Background="#F05569" Margin="0,0,6,0" /><TextBlock Text="Low Collisions" VerticalAlignment="Center" /></StackPanel>
      </Grid>
    </ListBoxItem>
    <ListBoxItem ToolTip.Tip="High Collisions · Blue · Paint to Apply, Erase or Delete Selection to Remove">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <CheckBox x:Name="HighCollisionVisible" IsChecked="False" IsCheckedChanged="ViewChanged" Theme="{StaticResource LayerVisibility}" ToolTip.Tip="Show / Hide High Collisions" AutomationProperties.Name="High Collisions Visibility" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Width="7" Height="7" CornerRadius="2" Background="#41A5F5" Margin="0,0,6,0" /><TextBlock Text="High Collisions" VerticalAlignment="Center" /></StackPanel>
      </Grid>
    </ListBoxItem>
  </ListBox>
  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,5,0,0" Padding="5,5,0,2"><TextBlock Text="Cell Highlights" Theme="{StaticResource SectionTitle}" FontSize="9" /></Border>
  <local:ResponsivePanel ItemMinWidth="160">
    <CheckBox x:Name="LightCellsVisible" Content="Light Cells" Theme="{StaticResource LayerHighlight}" IsCheckedChanged="ViewChanged" ToolTip.Tip="Highlight Light Cells in Amber, Including Effect Values." />
    <CheckBox x:Name="DoorCellsVisible" Content="Door Cells" Theme="{StaticResource LayerHighlight}" IsCheckedChanged="ViewChanged" ToolTip.Tip="Highlight Door Cells in Cyan When the Door Index or Offset Is Nonzero." />
  </local:ResponsivePanel>
</StackPanel>
<StackPanel Grid.Row="2"><DockPanel Margin="0,0,0,10"><TextBlock x:Name="AssetTitle" Text="Terrain Patterns" Theme="{StaticResource SectionTitle}" /><TextBlock x:Name="AssetCount" Text="0 Sets" Foreground="{DynamicResource Muted}" FontSize="10" HorizontalAlignment="Right" /></DockPanel><ComboBox x:Name="LibraryList" DisplayMemberBinding="{Binding Label}" SelectionChanged="LibraryChanged" ToolTip.Tip="Select a Crystal Library" /><Border x:Name="StampFolderHint" IsVisible="False" Background="{DynamicResource Theme252C38}" CornerRadius="5" Padding="10,8"><TextBlock x:Name="StampFolderLabel" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ThemeAAB6CA}" FontSize="11" /></Border><Grid Margin="0,8,0,10"><TextBox x:Name="AssetSearch" Theme="{StaticResource PaletteSearchBox}" Tag="Search Pattern or Sprite ID…" TextChanged="SearchChanged" Margin="0" ToolTip.Tip="Filter Assets by Numeric ID" /><Button Content="×" Click="ClearSearchClick" HorizontalAlignment="Right" Theme="{StaticResource QuietButton}" Padding="7,1" Margin="3" ToolTip.Tip="Clear Search" /></Grid></StackPanel>
<Grid Grid.Row="3" x:Name="AssetArea" SizeChanged="AssetAreaSizeChanged"><ListBox x:Name="AssetList" SelectionChanged="AssetChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><StackPanel Width="78" ToolTip.Tip="{Binding Description}"><Grid><Border Height="68" Background="{DynamicResource Theme151B24}" CornerRadius="4"><Image Source="{Binding Bitmap}" Stretch="Uniform" Margin="5" RenderOptions.BitmapInterpolationMode="None" /></Border><Button Content="{Binding PinLabel}" IsEnabled="{Binding CanPin}" ToolTip.Tip="{Binding PinHint}" AutomationProperties.Name="{Binding PinHint}" Click="PinAssetClick" Theme="{StaticResource QuietButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="3,0" Margin="1" FontSize="15" Background="{DynamicResource Theme1C2028}" /></Grid><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" TextAlignment="Center" FontSize="10" Margin="0,6,0,0" Foreground="{DynamicResource ThemeB9C3D5}" /><TextBlock Text="{Binding Detail}" IsVisible="{Binding DetailVisible}" TextTrimming="CharacterEllipsis" TextAlignment="Center" FontSize="9" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
<StackPanel x:Name="AssetEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"><TextBlock x:Name="EmptyIcon" Text="▦" FontSize="30" Foreground="{DynamicResource Theme61708C}" HorizontalAlignment="Center" /><TextBlock x:Name="EmptyTitle" Text="Your Assets Live Here" FontWeight="SemiBold" TextAlignment="Center" Margin="0,14,0,6" /><TextBlock x:Name="EmptyDescription" Text="Choose your Crystal library folder once.&#10;It will load automatically next time." Foreground="{DynamicResource Muted}" TextAlignment="Center" TextWrapping="Wrap" FontSize="11" /><Button x:Name="EmptyAction" Content="Set Library Folder" Click="EmptyActionClick" Theme="{StaticResource PrimaryButton}" Margin="0,16,0,0" /></StackPanel></Grid>
<Grid Grid.Row="4" Margin="0,10,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button x:Name="PreviousButton" Content="←" Click="PreviousPage" Padding="10,4" ToolTip.Tip="Previous Page" /><TextBlock Grid.Column="1" x:Name="PageLabel" Text="No Library Loaded" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Muted}" /><Button Grid.Column="2" x:Name="NextButton" Content="→" Click="NextPage" Padding="10,4" ToolTip.Tip="Next Page" /></Grid>
<StackPanel Grid.Row="5"><Border Background="{DynamicResource Theme242C39}" BorderBrush="{DynamicResource Theme354155}" BorderThickness="1" CornerRadius="6" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition /></Grid.ColumnDefinitions><Border Background="{DynamicResource Theme171D27}" CornerRadius="4" Height="42"><Image x:Name="SelectedPreview" Stretch="Uniform" Margin="3" /></Border><StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="SelectedPreviewCaption" Text="Active Asset" TextWrapping="Wrap" Theme="{StaticResource SectionTitle}" FontSize="9" /><TextBlock x:Name="SelectedLabel" Text="Choose a Terrain Pattern" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" /><Button x:Name="SelectedPinButton" Content="☆ Pin to Favourites" Click="PinActiveAssetClick" Theme="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="0,3" FontSize="10" /></StackPanel></Grid></Border><Expander Header="Cell Inspector" IsExpanded="False" Margin="0,8,0,0"><StackPanel><TextBlock x:Name="Inspector" Text="Hover over a cell to inspect it" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,3" /><local:ResponsivePanel x:Name="InspectorDetails" ItemMinWidth="245" /></StackPanel></Expander></StackPanel>
</Grid></Border></Grid>
<Border Grid.Row="4" Background="{DynamicResource Theme171B22}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"><Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="150" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="Status" Text="Ready" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource ThemeADB8C9}" /><TextBlock Grid.Column="1" x:Name="Coordinates" Text="—, —" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11" /><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="LibraryDot" Width="6" Height="6" Fill="{DynamicResource ThemeD1AD77}" Margin="0,0,7,0" /><TextBlock x:Name="LibraryStatus" Text="Libraries not configured" FontSize="10" Foreground="{DynamicResource Muted}" /><TextBlock x:Name="Performance" Text="" IsVisible="False" /></StackPanel></Grid></Border>
<ProgressBar x:Name="BusyProgress" Grid.Row="2" Height="2" VerticalAlignment="Bottom" IsIndeterminate="True" Foreground="{DynamicResource Theme8CA1FF}" Background="Transparent" BorderThickness="0" IsVisible="False" />
</Grid></local:EditorWindow>