<local:EditorWindow xmlns="https://github.com/avaloniaui" xmlns:local="clr-namespace:CrystalStudio" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CrystalStudio.ProvinceGeneratorWindow" Title="{local:Loc ProvinceGenerator_F8D5F7AB}" Width="1100" Height="780" MinWidth="850" MinHeight="650" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Theme14171D}" Foreground="{DynamicResource ThemeE5E9F0}">
    <Grid Margin="20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="265" /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid><Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,0">
            <TextBlock Text="{local:Loc OutdoorProvince_EB80CC30}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{local:Loc SceneTheme}" />
            <ComboBox x:Name="SceneList" SelectionChanged="SceneChanged" Margin="0,6,0,14" AutomationProperties.Name="{local:Loc SceneTheme}">
                <ComboBoxItem Content="{local:Loc WildernessScene}" />
                <ComboBoxItem Content="{local:Loc VillageCountrysideScene}" />
                <ComboBoxItem Content="{local:Loc ForestRuinsScene}" />
                <ComboBoxItem Content="{local:Loc MiningQuarryScene}" />
            </ComboBox>
            <TextBlock Text="{local:Loc LandscapeStyle_95397827}" />
            <ComboBox x:Name="StyleList" SelectionChanged="SettingsChanged" Margin="0,6,0,18" AutomationProperties.Name="{local:Loc ProvinceLandscapeStyle_84104B72}" />
            <TextBlock Text="{local:Loc ChanceperGeneratedMap_482493D3}" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBlock><Run Text="{local:Loc WiderBorder_538E1AA9}" /><Run Text="{Binding ElementName=ForestSlider, Path=Value, StringFormat={}{0:0}%}" /></TextBlock>
            <Grid ColumnDefinitions="*,8,66" Margin="0,4,0,12"><Slider x:Name="ForestSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="85" ValueChanged="SettingsChanged" AutomationProperties.Name="{local:Loc WiderBorderChance_7AAAA257}" ToolTip.Tip="{local:Loc WoodlandinBichonRockyCoverinDesertStyles_3B279EE4}" /><local:GeneratorValueEditor Grid.Column="2" Slider="{Binding ElementName=ForestSlider}" /></Grid>
            <TextBlock><Run Text="{local:Loc CliffBorder_C96CCF14}" /><Run Text="{Binding ElementName=CliffSlider, Path=Value, StringFormat={}{0:0}%}" /></TextBlock>
            <Grid ColumnDefinitions="*,8,66" Margin="0,4,0,12"><Slider x:Name="CliffSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="70" ValueChanged="SettingsChanged" AutomationProperties.Name="{local:Loc CliffBorderChance_0266F4BE}" ToolTip.Tip="{local:Loc CliffsCanSpanOneTwoThreeorAllFourSidesJoiningAroundCornersBeaches_0E08F56C}" /><local:GeneratorValueEditor Grid.Column="2" Slider="{Binding ElementName=CliffSlider}" /></Grid>
            <TextBlock><Run Text="{local:Loc Amountofdoors_7B539A2E}" /><Run Text="{Binding ElementName=DoorCountSlider, Path=Value, StringFormat={}{0:0}}" /></TextBlock>
            <Grid ColumnDefinitions="*,8,66" Margin="0,4,0,6"><Slider x:Name="DoorCountSlider" Minimum="0" Maximum="32" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SettingsChanged" AutomationProperties.Name="{local:Loc Amountofdoors_DC5C3D82}" /><local:GeneratorValueEditor Grid.Column="2" Slider="{Binding ElementName=DoorCountSlider}" /></Grid>
            <TextBlock x:Name="DoorHint" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,12" />
            <TextBlock><Run Text="{local:Loc Beach_69FF7B88}" /><Run Text="{Binding ElementName=BeachSlider, Path=Value, StringFormat={}{0:0}%}" /></TextBlock>
            <Grid ColumnDefinitions="*,8,66" Margin="0,4,0,12"><Slider x:Name="BeachSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="35" ValueChanged="SettingsChanged" AutomationProperties.Name="{local:Loc BeachChance_2F7DB4BE}" /><local:GeneratorValueEditor Grid.Column="2" Slider="{Binding ElementName=BeachSlider}" /></Grid>
            <TextBlock><Run Text="{local:Loc River_C9BB8AF8}" /><Run Text="{Binding ElementName=RiverSlider, Path=Value, StringFormat={}{0:0}%}" /></TextBlock>
            <Grid ColumnDefinitions="*,8,66" Margin="0,4,0,12"><Slider x:Name="RiverSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="55" ValueChanged="SettingsChanged" AutomationProperties.Name="{local:Loc RiverChance_2F2A954A}" /><local:GeneratorValueEditor Grid.Column="2" Slider="{Binding ElementName=RiverSlider}" /></Grid>
            <TextBlock Text="{local:Loc InteriorVegetation_B15DE6A3}" />
            <Grid ColumnDefinitions="*,8,66" Margin="0,4,0,18"><Slider x:Name="VegetationSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="55" ValueChanged="SettingsChanged" AutomationProperties.Name="{local:Loc InteriorVegetation_B15DE6A3}" /><local:GeneratorValueEditor Grid.Column="2" Slider="{Binding ElementName=VegetationSlider}" /></Grid>
            <TextBlock><Run Text="{local:Loc TownCount_9041BBE0}" /><Run Text="{Binding ElementName=TownCountSlider, Path=Value, StringFormat={}{0:0}}" /></TextBlock>
            <Grid ColumnDefinitions="*,8,66" Margin="0,4,0,12"><Slider x:Name="TownCountSlider" Minimum="0" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" Value="0" ValueChanged="SettingsChanged" AutomationProperties.Name="{local:Loc TownCount_5495A825}" ToolTip.Tip="{local:Loc FitTownstoDryClearingsandConnectTheirStreetsCrowdedMapsMayFitFewe_F095EDB3}" /><local:GeneratorValueEditor Grid.Column="2" Slider="{Binding ElementName=TownCountSlider}" /></Grid>
            <StackPanel x:Name="RuinOptions" IsVisible="False">
                <TextBlock><Run Text="{local:Loc RuinCount}" /><Run Text="{Binding ElementName=RuinCountSlider, Path=Value, StringFormat={}{0:0}}" /></TextBlock>
                <Grid ColumnDefinitions="*,8,66" Margin="0,4,0,12"><Slider x:Name="RuinCountSlider" Minimum="1" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" Value="2" ValueChanged="SettingsChanged" AutomationProperties.Name="{local:Loc RuinCount}" /><local:GeneratorValueEditor Grid.Column="2" Slider="{Binding ElementName=RuinCountSlider}" /></Grid>
            </StackPanel>
            <StackPanel x:Name="MineOptions" IsVisible="False">
                <TextBlock><Run Text="{local:Loc MineCount}" /><Run Text="{Binding ElementName=MineCountSlider, Path=Value, StringFormat={}{0:0}}" /></TextBlock>
                <Grid ColumnDefinitions="*,8,66" Margin="0,4,0,12"><Slider x:Name="MineCountSlider" Minimum="1" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" Value="2" ValueChanged="SettingsChanged" AutomationProperties.Name="{local:Loc MineCount}" /><local:GeneratorValueEditor Grid.Column="2" Slider="{Binding ElementName=MineCountSlider}" /></Grid>
            </StackPanel>
        </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Text="{local:Loc Seed_367EF06B}" />
            <DockPanel Margin="0,6,0,0"><Button DockPanel.Dock="Right" Content="{local:Loc GeneratorChangeSeed}" Click="ShuffleClick" Margin="8,0,0,0" Padding="10,4" ToolTip.Tip="{local:Loc GeneratorChangeSeedHelp}" /><TextBox x:Name="SeedBox" Text="1" TextChanged="SettingsChanged" AutomationProperties.Name="{local:Loc ProvinceSeed_00DB2769}" /></DockPanel>
        </StackPanel></Grid>
        <Border Grid.Column="2" Background="{DynamicResource Theme252C38}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="12">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                <StackPanel><DockPanel><CheckBox x:Name="DetailToggle" DockPanel.Dock="Right" Content="{local:Loc CentreDetail_E3824490}" IsCheckedChanged="SettingsChanged" Foreground="{DynamicResource ThemeE5E9F0}" ToolTip.Tip="{local:Loc GeneratorCentreDetailHelp}" /><TextBlock Text="{local:Loc ProvincePreview_355E121E}" FontWeight="SemiBold" /></DockPanel><TextBlock x:Name="PreviewMapInfo" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" /></StackPanel>
                <local:GeneratorPreview x:Name="PreviewNavigator" Grid.Row="1" Margin="0,12,0,0"><local:GeneratorPreview.Image><Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" /></local:GeneratorPreview.Image></local:GeneratorPreview>
                <TextBlock x:Name="PreviewHint" Grid.Row="1" Text="{local:Loc LoadingOutdoorArtwork_A16E8ED6}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" Foreground="{DynamicResource Muted}" />
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" Grid.ColumnSpan="3" MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,0">
            <TextBlock x:Name="FeedbackText" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" />
        </ScrollViewer>
        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,16,0,0" LastChildFill="False">
            <Button x:Name="ApplyButton" DockPanel.Dock="Right" Content="{local:Loc ReplaceMapwithProvince_12F3C8B2}" IsEnabled="False" Click="ApplyClick" Padding="18,7" />
            <Button DockPanel.Dock="Right" Content="{local:Loc Cancel_19766ED6}" IsCancel="True" Margin="0,0,8,0" Padding="18,7" />
            <Button x:Name="RandomizeButton" DockPanel.Dock="Left" Content="{local:Loc GeneratorRandomizeSettings}" IsEnabled="False" Click="RandomizeClick" Padding="18,7" ToolTip.Tip="{local:Loc RandomizetheLandscapeStyleFeatureChancesVegetationTownCountandSee_147DEBAF}" />
        </DockPanel>
    </Grid>
</local:EditorWindow>
