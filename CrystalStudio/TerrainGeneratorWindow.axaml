<local:EditorWindow xmlns="https://github.com/avaloniaui" xmlns:local="clr-namespace:CrystalStudio" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CrystalStudio.TerrainGeneratorWindow" Title="Generate Terrain" Width="1060" Height="760" MinWidth="830" MinHeight="630" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Theme14171D}" Foreground="{DynamicResource ThemeE5E9F0}">
    <Window.Resources><ResourceDictionary /></Window.Resources>
    <Grid Margin="20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid x:Name="OptionsPanel">
            <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="Category" FontWeight="SemiBold" /><ComboBox x:Name="BiomeList" Margin="0,6,0,12" SelectionChanged="BiomeChanged" AutomationProperties.Name="Terrain Category" />
            <TextBlock Text="Base Terrain" FontWeight="SemiBold" /><ComboBox x:Name="BaseList" Margin="0,6,0,12" SelectionChanged="BaseChanged" AutomationProperties.Name="Base Terrain" />
            <TabControl x:Name="TerrainTabs" Theme="{StaticResource PaletteTabControl}">
            <TabItem Header="Ground" Theme="{StaticResource PaletteTabItem}"><StackPanel Margin="0,12,0,0">
            <TextBlock Text="Irregular Patches" FontWeight="SemiBold" /><ComboBox x:Name="PatchList" Margin="0,6,0,12" SelectionChanged="SettingsChanged" AutomationProperties.Name="Patch Terrain" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock><Run Text="Patch Amount · " /><Run Text="{Binding ElementName=CoverageSlider, Path=Value, StringFormat=P0}" /></TextBlock>
                <Slider x:Name="CoverageSlider" Grid.Row="1" Minimum="0" Maximum="1" Value="0.45" SmallChange="0.05" Margin="0,4,0,12" ValueChanged="SettingsChanged" AutomationProperties.Name="Patch Amount" />
                <TextBlock Grid.Column="2"><Run Text="Scale · " /><Run Text="{Binding ElementName=ScaleSlider, Path=Value, StringFormat=F0}" /><Run Text=" Tiles" /></TextBlock>
                <Slider x:Name="ScaleSlider" Grid.Row="1" Grid.Column="2" Minimum="2" Maximum="40" Value="10" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,12" ValueChanged="SettingsChanged" AutomationProperties.Name="Patch Scale" ToolTip.Tip="Patch Scale in Ground Tiles" />
            </Grid>
            <TextBlock Text="Winding Paths" FontWeight="SemiBold" /><ComboBox x:Name="PathList" Margin="0,6,0,12" SelectionChanged="SettingsChanged" AutomationProperties.Name="Path Terrain" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock><Run Text="Path Width · " /><Run Text="{Binding ElementName=WidthSlider, Path=Value, StringFormat=F0}" /><Run Text=" Tiles" /></TextBlock>
                <Slider x:Name="WidthSlider" Grid.Row="1" Minimum="2" Maximum="10" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,12" VerticalAlignment="Center" ValueChanged="SettingsChanged" AutomationProperties.Name="Path Width" ToolTip.Tip="Path Width in Ground Tiles" />
                <TextBlock Grid.Column="2" Text="Connected Routes" />
                <ComboBox x:Name="RouteList" Grid.Row="1" Grid.Column="2" Margin="0,4,0,12" SelectionChanged="SettingsChanged" AutomationProperties.Name="Connected Routes"><ComboBoxItem Content="1" /><ComboBoxItem Content="2" /><ComboBoxItem Content="3" /></ComboBox>
            </Grid>
            </StackPanel></TabItem>
            <TabItem x:Name="WaterTab" Header="Water" Theme="{StaticResource PaletteTabItem}"><StackPanel Margin="0,12,0,0">
                <TextBlock Text="Rivers and Coasts" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                    <CheckBox x:Name="RiverToggle" Content="River" IsEnabled="False" IsCheckedChanged="SettingsChanged" Foreground="{DynamicResource ThemeE5E9F0}" AutomationProperties.Name="River" Margin="0,0,24,0" />
                    <CheckBox x:Name="BeachToggle" Content="Beach" IsEnabled="False" IsCheckedChanged="SettingsChanged" Foreground="{DynamicResource ThemeE5E9F0}" AutomationProperties.Name="Beach" />
                </StackPanel>
                <CheckBox x:Name="BridgeToggle" Content="Bridge Crossing" IsEnabled="False" Margin="0,0,0,12" IsCheckedChanged="SettingsChanged" Foreground="{DynamicResource ThemeE5E9F0}" AutomationProperties.Name="Bridge Crossing" />
            </StackPanel></TabItem>
            </TabControl>
        </StackPanel></ScrollViewer>
            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                <TextBlock Text="Seed" />
                <DockPanel Margin="0,6,0,0"><Button DockPanel.Dock="Right" Content="Shuffle" Click="ShuffleClick" Padding="10,4" Margin="8,0,0,0" ToolTip.Tip="Randomize Only the Seed" /><TextBox x:Name="SeedBox" Text="1" TextChanged="SettingsChanged" AutomationProperties.Name="Terrain Seed" /></DockPanel>
            </StackPanel>
        </Grid>
        <Border Grid.Column="2" Background="{DynamicResource Theme252C38}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="12">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                <DockPanel><CheckBox x:Name="DetailToggle" DockPanel.Dock="Right" Content="Centre Detail" IsCheckedChanged="DetailChanged" Foreground="{DynamicResource ThemeE5E9F0}" /><TextBlock Text="Terrain Preview" FontWeight="SemiBold" /></DockPanel>
                <Image x:Name="PreviewImage" Grid.Row="1" Stretch="Uniform" Margin="0,12,0,0" RenderOptions.BitmapInterpolationMode="None" AutomationProperties.Name="Generated Terrain Preview" />
                <TextBlock x:Name="PreviewHint" Grid.Row="1" Text="Preview updates automatically." TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" Foreground="{DynamicResource Muted}" />
            </Grid>
        </Border>
        <TextBlock x:Name="FeedbackText" Grid.Row="1" Grid.ColumnSpan="3" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,14,0,0" />
        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,16,0,0" LastChildFill="False">
            <Button x:Name="ApplyButton" DockPanel.Dock="Right" Content="Apply Terrain" IsEnabled="False" Click="ApplyClick" Padding="18,7" />
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Margin="0,0,8,0" Padding="18,7" />
            <Button x:Name="RandomizeButton" DockPanel.Dock="Left" Content="Randomize" Click="RandomizeClick" Padding="18,7" IsEnabled="False" ToolTip.Tip="Randomize All Generation Settings Using Compatible Terrain" />
        </DockPanel>
    </Grid>
</local:EditorWindow>