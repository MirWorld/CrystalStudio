<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Theme2A303B}"/>
    <Setter Property="Foreground" Value="{DynamicResource ThemeE5E9F0}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Theme3B4350}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,7"/>
    <Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><ControlTemplate><Border Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
      <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
    </Border></ControlTemplate></Setter>
    <Style Selector="^:pointerover /template/ Border#Chrome"><Setter Property="Background" Value="{DynamicResource Theme394354}"/><Setter Property="BorderBrush" Value="{DynamicResource Theme657591}"/></Style>
    <Style Selector="^:pressed /template/ Border#Chrome"><Setter Property="Background" Value="{DynamicResource Theme202632}"/></Style>
    <Style Selector="^:focus-visible /template/ Border#Chrome"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Style>
    <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.35"/></Style>
  </ControlTheme>
  <ControlTheme x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></ControlTheme>
  <ControlTheme x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource Theme6378DF}"/><Setter Property="BorderBrush" Value="{DynamicResource Theme8498FF}"/><Setter Property="Foreground" Value="{DynamicResource OnAccent}"/><Setter Property="FontWeight" Value="SemiBold"/></ControlTheme>
  <ControlTheme x:Key="ToolButton" TargetType="RadioButton">
    <Setter Property="GroupName" Value="EditorTools"/><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
    <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Margin" Value="2"/>
    <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{DynamicResource Theme9BA5B6}"/>
    <Setter Property="Template"><ControlTemplate><Border Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5">
      <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border></ControlTemplate></Setter>
    <Style Selector="^:pointerover"><Setter Property="Foreground" Value="{DynamicResource ThemeE5E9F0}"/></Style>
    <Style Selector="^:pointerover /template/ Border#Chrome"><Setter Property="Background" Value="{DynamicResource Theme2B3240}"/></Style>
    <Style Selector="^:checked"><Setter Property="Foreground" Value="{DynamicResource ThemeBBC6FF}"/></Style>
    <Style Selector="^:checked /template/ Border#Chrome"><Setter Property="Background" Value="{DynamicResource Theme2B355A}"/><Setter Property="BorderBrush" Value="{DynamicResource Theme596CA8}"/></Style>
    <Style Selector="^:focus-visible /template/ Border#Chrome"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Style>
    <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.35"/></Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource ThemeB7C1D0}"/><Setter Property="Margin" Value="6,5"/><Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template"><ControlTemplate><StackPanel Orientation="Horizontal" Background="Transparent">
      <Border Name="Box" Width="14" Height="14" Background="{DynamicResource Theme171C25}" BorderBrush="{DynamicResource Theme586477}" BorderThickness="1" CornerRadius="3" Margin="0,0,7,0" VerticalAlignment="Center">
        <TextBlock Name="Mark" Text="✓" Foreground="{DynamicResource ThemeC8D2FF}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False"/>
      </Border><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center"/>
    </StackPanel></ControlTemplate></Setter>
    <Style Selector="^:checked /template/ Border#Box"><Setter Property="Background" Value="{DynamicResource Theme394874}"/><Setter Property="BorderBrush" Value="{DynamicResource Theme7F94D6}"/></Style>
    <Style Selector="^:checked /template/ TextBlock#Mark"><Setter Property="IsVisible" Value="True"/></Style>
    <Style Selector="^:indeterminate /template/ TextBlock#Mark"><Setter Property="Text" Value="−"/><Setter Property="IsVisible" Value="True"/></Style>
    <Style Selector="^:pointerover /template/ Border#Box"><Setter Property="BorderBrush" Value="{DynamicResource ThemeADBFFF}"/></Style>
    <Style Selector="^:focus-visible /template/ Border#Box"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Style>
    <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.35"/></Style>
  </ControlTheme>
  <ControlTheme x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="{DynamicResource ThemeAAB4C4}"/></ControlTheme>
  <ControlTheme x:Key="PaletteSearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="8,4,28,4"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Watermark" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/></ControlTheme>
  <ControlTheme x:Key="PaletteTabControl" TargetType="TabControl">
    <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource ThemeE5E9F0}"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="ItemsPanel"><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></Setter>
    <Setter Property="Template"><ControlTemplate><Grid RowDefinitions="Auto,*">
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="6,0"><ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/></Border>
      <ContentPresenter Name="PART_SelectedContentHost" Grid.Row="1" Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid></ControlTemplate></Setter>
  </ControlTheme>
  <ControlTheme x:Key="PaletteTabItem" TargetType="TabItem">
    <Setter Property="Padding" Value="8,7"/><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="Template"><ControlTemplate><Border Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
      <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" RecognizesAccessKey="True" HorizontalAlignment="Center"/>
    </Border></ControlTemplate></Setter>
    <Style Selector="^:pointerover /template/ Border#Chrome"><Setter Property="Background" Value="{DynamicResource Theme29313E}"/></Style>
    <Style Selector="^:selected /template/ Border#Chrome"><Setter Property="BorderBrush" Value="{DynamicResource Theme8CA1FF}"/></Style>
    <Style Selector="^:selected"><Setter Property="Foreground" Value="{DynamicResource ThemeE5E9F0}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </ControlTheme>
  <ControlTheme x:Key="LayerRow" TargetType="ListBoxItem">
    <Setter Property="MinHeight" Value="26"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="4,1"/><Setter Property="FontSize" Value="11"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><ControlTemplate><Border Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
      <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Border></ControlTemplate></Setter>
    <Style Selector="^:pointerover /template/ Border#Chrome"><Setter Property="Background" Value="{DynamicResource Theme29313E}"/></Style>
    <Style Selector="^:selected /template/ Border#Chrome"><Setter Property="Background" Value="{DynamicResource Theme2B3657}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Style>
    <Style Selector="^:focus-within /template/ Border#Chrome"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Style>
  </ControlTheme>
  <ControlTheme x:Key="LayerVisibility" TargetType="CheckBox">
    <Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Foreground" Value="{DynamicResource ThemeE5E9F0}"/>
    <Setter Property="Template"><ControlTemplate><Border Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3"><Grid Width="16" Height="16">
      <Path Name="Eye" Data="M 1,8 C 4,2 12,2 15,8 C 12,14 4,14 1,8 Z M 10,8 A 2,2 0 1 1 6,8 A 2,2 0 1 1 10,8" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2"/>
      <Path Name="Hidden" Data="M 2,2 L 14,14" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" IsVisible="True"/>
    </Grid></Border></ControlTemplate></Setter>
    <Style Selector="^:unchecked"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Style>
    <Style Selector="^:unchecked /template/ Path#Eye"><Setter Property="Opacity" Value="0.55"/></Style>
    <Style Selector="^:checked /template/ Path#Hidden"><Setter Property="IsVisible" Value="False"/></Style>
    <Style Selector="^:pointerover /template/ Border#Chrome"><Setter Property="Background" Value="{DynamicResource Theme394455}"/></Style>
    <Style Selector="^:focus-visible /template/ Border#Chrome"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Style>
    <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.35"/></Style>
  </ControlTheme>
  <ControlTheme x:Key="LayerHighlight" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Margin" Value="5,0"/><Setter Property="MinHeight" Value="24"/><Setter Property="FontSize" Value="11"/></ControlTheme>
  <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">
    <Setter Property="MinHeight" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="Focusable" Value="True"/>
    <Setter Property="Template"><ControlTemplate><Grid Background="Transparent">
      <Border Height="3" Background="{DynamicResource Theme394455}" CornerRadius="2" VerticalAlignment="Center"/>
      <Track Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
        <Track.DecreaseButton><RepeatButton Name="PART_DecreaseButton" Focusable="False" MinWidth="0" MinHeight="0" Margin="0" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"><RepeatButton.Template><ControlTemplate><Border Height="3" Background="{DynamicResource Theme8298E0}" CornerRadius="2" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseButton>
        <Track.Thumb><Thumb Name="PART_Thumb" Width="12" Height="18" MinWidth="0" MinHeight="0"><Thumb.Template><ControlTemplate><Border Background="{DynamicResource ThemeA5B7F1}" BorderBrush="{DynamicResource ThemeD0DBFF}" BorderThickness="1" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        <Track.IncreaseButton><RepeatButton Name="PART_IncreaseButton" Focusable="False" MinWidth="0" MinHeight="0" Margin="0" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseButton>
      </Track>
    </Grid></ControlTemplate></Setter>
  </ControlTheme>
  <ControlTheme x:Key="CategoryTabControl" TargetType="TabControl">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate></Setter>
    <Setter Property="Template"><ControlTemplate><Grid ColumnDefinitions="90,*">
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Margin="0,0,4,0">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
        </ScrollViewer>
      </Border>
      <ContentPresenter Name="PART_SelectedContentHost" Grid.Column="1" Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid></ControlTemplate></Setter>
  </ControlTheme>
  <ControlTheme x:Key="CategoryTabItem" TargetType="TabItem">
    <Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="6,7"/><Setter Property="Margin" Value="0,1"/>
    <Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
    <Setter Property="Template"><ControlTemplate><Border Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0" Padding="{TemplateBinding Padding}">
      <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/>
    </Border></ControlTemplate></Setter>
    <Style Selector="^:pointerover /template/ Border#Chrome"><Setter Property="Background" Value="{DynamicResource Theme29313E}"/></Style>
    <Style Selector="^:selected /template/ Border#Chrome"><Setter Property="Background" Value="{DynamicResource Theme2B3657}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Style>
    <Style Selector="^:selected"><Setter Property="Foreground" Value="{DynamicResource ThemeE5E9F0}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="^:focus-visible /template/ Border#Chrome"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Style>
  </ControlTheme>
  <ControlTheme x:Key="CategoryCard" TargetType="ListBoxItem" BasedOn="{StaticResource LayerRow}">
    <Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="3"/><Setter Property="Margin" Value="2"/>
    <Setter Property="Focusable" Value="True"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
  </ControlTheme>
</ResourceDictionary>
