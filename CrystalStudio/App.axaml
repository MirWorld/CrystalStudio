<SolidColorBrush x:Key="Panel" Color="#1C2028" /><SolidColorBrush x:Key="Muted" Color="#929CAB" /><SolidColorBrush x:Key="Accent" Color="#8498FF" /><SolidColorBrush x:Key="Line" Color="#303640" />
<ResourceDictionary.MergedDictionaries><ResourceInclude Source="/EditorControls.axaml"/></ResourceDictionary.MergedDictionaries>
<DataTemplate x:Key="StampCategoryCardTemplate">
  <StackPanel ToolTip.ShowDelay="250">
    <ToolTip.Tip><TextBlock Text="{Binding Description}" MaxWidth="360" TextWrapping="Wrap"/></ToolTip.Tip>
    <Border Height="78" Background="{DynamicResource Theme151B24}" CornerRadius="4">
      <Image local:CategoryPreviewVisibility.Track="True" Stretch="Uniform" Source="{Binding Bitmap}" Margin="4" RenderOptions.BitmapInterpolationMode="None"/>
    </Border>
    <TextBlock Text="{Binding ShortLabel}" TextTrimming="CharacterEllipsis" TextAlignment="Center" FontSize="10" Margin="1,5,1,1"/>
  </StackPanel>
</DataTemplate>
</ResourceDictionary></Application.Resources>
<Application.Styles><FluentTheme/>
<Style Selector="Window"><Setter Property="Background" Value="{DynamicResource Theme14171D}"/><Setter Property="Foreground" Value="{DynamicResource ThemeE5E9F0}"/><Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei, sans-serif"/><Setter Property="FontSize" Value="12"/></Style>
<Style Selector="TextBox"><Setter Property="Background" Value="{DynamicResource Theme14181F}"/><Setter Property="Foreground" Value="{DynamicResource ThemeE5E9F0}"/><Setter Property="BorderBrush" Value="{DynamicResource Theme353E4C}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="9,8"/><Setter Property="Margin" Value="3"/><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="0"/></Style>
<Style Selector="ComboBox"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="10,8,28,8"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource ThemeE5E9F0}"/><Setter Property="Background" Value="{DynamicResource Theme252C38}"/></Style>
<Style Selector="ComboBoxItem"><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="12"/></Style>
<Style Selector="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource ThemeE5E9F0}"/></Style>
<Style Selector="TabControl"><Setter Property="FontSize" Value="12"/><Setter Property="ItemContainerTheme" Value="{StaticResource PaletteTabItem}"/><Setter Property="Theme" Value="{StaticResource PaletteTabControl}"/></Style>
<Style Selector="Slider"><Setter Property="MinHeight" Value="24"/><Setter Property="Height" Value="24"/></Style>
<Style Selector="Slider /template/ Thumb"><Setter Property="Width" Value="12"/><Setter Property="Height" Value="18"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Template"><ControlTemplate><Border Background="{DynamicResource ThemeA5B7F1}" BorderBrush="{DynamicResource ThemeD0DBFF}" BorderThickness="1" CornerRadius="3"/></ControlTemplate></Setter></Style>
<Style Selector="ScrollBar"><Setter Property="MinWidth" Value="9"/><Setter Property="MinHeight" Value="9"/></Style>
</Application.Styles></Application>
