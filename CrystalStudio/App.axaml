<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CrystalStudio" x:Class="CrystalStudio.App" RequestedThemeVariant="Dark">
