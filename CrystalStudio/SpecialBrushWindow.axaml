<local:EditorWindow xmlns="https://github.com/avaloniaui" xmlns:local="clr-namespace:CrystalStudio" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CrystalStudio.SpecialBrushWindow" Title="{local:Loc SpecialBrush_D413BD9E}" Width="1140" Height="820" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <DataTemplate x:Key="TreeRow">
            <Grid Margin="2" ToolTip.Tip="{Binding File}"><Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource Theme252C38}" CornerRadius="3" Height="48"><Image Source="{Binding Preview.Bitmap}" Stretch="Uniform" Margin="3" /></Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{local:LocValue Type}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="TreeSettings" Margin="20">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="12" /><ColumnDefinition Width="200" /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{local:Loc Brush_8624CA0F}" Foreground="{DynamicResource Muted}" Margin="0,0,0,5" /><ComboBox x:Name="BrushTypeList" SelectedIndex="0" SelectionChanged="BrushTypeChanged" AutomationProperties.Name="{local:Loc SpecialBrushType_80BEE679}"><ComboBoxItem Content="{local:Loc TreeBrush_6612E83E}" Tag="Tree" /><ComboBoxItem Content="{local:Loc BushBrush_ACAC52DA}" Tag="Bush" /><ComboBoxItem Content="{local:Loc RockBrush_3465C010}" Tag="Rock" /></ComboBox></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock x:Name="TypeLabel" Text="{local:Loc TreeType_23B1CC6A}" Foreground="{DynamicResource Muted}" Margin="0,0,0,5" /><ComboBox x:Name="TypeList" SelectionChanged="TypeChanged" AutomationProperties.Name="{local:Loc ObjectType_149F598E}" ToolTip.Tip="{local:Loc TreeType_23B1CC6A}" /></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="{local:Loc Search_49C266BA}" Foreground="{DynamicResource Muted}" Margin="0,0,0,5" /><TextBox x:Name="SearchBox" Height="34" Margin="0" Padding="9,5" Tag="Search Trees…" TextChanged="FilterChanged" VerticalContentAlignment="Center" AutomationProperties.Name="{local:Loc SearchTrees_78BE6E2D}" /></StackPanel>
                <StackPanel Grid.Column="6"><TextBlock Text="{local:Loc PaintWith_F56BE6C8}" Foreground="{DynamicResource Muted}" Margin="0,0,0,5" /><ComboBox x:Name="PaintSourceList" SelectedIndex="0" SelectionChanged="PaintSourceChanged" AutomationProperties.Name="{local:Loc TreestoPaint_F9D6709F}" ToolTip.Tip="{local:Loc TreestoPaint_F9D6709F}">
                    <ComboBoxItem Content="{local:Loc RandomTreesfromThisType_18DCD298}" /><ComboBoxItem Content="{local:Loc MyTreeList_DF977162}" /><ComboBoxItem Content="{local:Loc SelectedTrees_F9103A8C}" />
                </ComboBox></StackPanel>
            </Grid>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="16" /><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition Width="0.95*" /></Grid.ColumnDefinitions>
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock x:Name="BrowseLabel" Text="{local:Loc BrowseTrees_EE5D65C6}" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <Border Grid.Row="1" Background="{DynamicResource Theme151B24}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5">
                        <Grid>
                            <ListBox x:Name="TreeList" ItemTemplate="{StaticResource TreeRow}" SelectionMode="Multiple" SelectionChanged="TreesChanged" DoubleTapped="TreeDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{local:Loc TreeVariants_E5705B8F}" ToolTip.Tip="{local:Loc DoubleClicktoAddaTreeCtrlClicktoSelectSeveral_8B725A55}" />
                            <TextBlock x:Name="EmptyLabel" Text="{local:Loc LoadingTrees_E2DC3572}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" IsHitTestVisible="False" Margin="16" />
                        </Grid>
                    </Border>
                    <WrapPanel Grid.Row="2" Margin="0,8,0,0"><Button x:Name="AddTreesButton" Content="{local:Loc AddSelected_C78A147B}" Click="AddTreesClick" /><Button x:Name="AddTypeButton" Content="{local:Loc AddType_E2757A4E}" Click="AddTypeClick" ToolTip.Tip="{local:Loc AddAllTreesofThisType_CA3C379A}" /></WrapPanel>
                </Grid>
                <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock x:Name="CuratedLabel" Text="{local:Loc MyTreeList_DF977162}" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <TextBox x:Name="ListNameBox" Grid.Row="1" Text="My trees" Height="32" Padding="8,4" MaxLength="256" VerticalContentAlignment="Center" TextChanged="ListNameChanged" AutomationProperties.Name="{local:Loc TreeListName_7E7B9C3F}" Margin="0,0,0,8" />
                    <Border Grid.Row="2" Background="{DynamicResource Theme151B24}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5"><ListBox x:Name="CuratedList" ItemTemplate="{StaticResource TreeRow}" SelectionMode="Multiple" SelectionChanged="CuratedSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{local:Loc MyCuratedTrees_DD043E56}" /></Border>
                    <Grid Grid.Row="3" Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <WrapPanel><Button x:Name="RemoveTreesButton" Content="{local:Loc Remove_C3812FC4}" Click="RemoveTreesClick" ToolTip.Tip="{local:Loc RemoveSelectedTrees_96A1A247}" /><Button x:Name="ClearTreesButton" Content="{local:Loc Clear_83B12C22}" Click="ClearTreesClick" ToolTip.Tip="{local:Loc ClearMyTreeList_ACCB1077}" /></WrapPanel>
                        <WrapPanel Grid.Row="1"><Button x:Name="SaveTreeListButton" Content="{local:Loc SaveList_FFD60838}" Click="SaveTreeListClick" /><Button x:Name="LoadTreeListButton" Content="{local:Loc LoadList_470E457A}" Click="LoadTreeListClick" /></WrapPanel>
                    </Grid>
                </Grid>
                <Grid Grid.Column="4"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10"><TextBlock x:Name="SelectedTreeName" Text="{local:Loc SelectaTree_5EACB1E7}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="SelectedTreeType" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /></StackPanel>
                    <Border Grid.Row="1" Background="{DynamicResource Theme151B24}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" MinHeight="180">
                        <Grid><Image x:Name="TreePreviewImage" Stretch="Uniform" Margin="14" RenderOptions.BitmapInterpolationMode="None" AutomationProperties.Name="{local:Loc SelectedTreePreview_4476C3C0}" /><TextBlock x:Name="PreviewPlaceholder" Text="{local:Loc SelectaTree_5EACB1E7}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
                    </Border>
                    <StackPanel Grid.Row="2" Margin="0,18,0,0">
                        <DockPanel><TextBlock Text="{local:Loc BrushSize_FB23F428}" /><TextBlock x:Name="SizeLabel" HorizontalAlignment="Right" /></DockPanel>
                        <Slider x:Name="SizeSlider" Minimum="3" Maximum="31" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="OptionsChanged" Margin="0,7,0,14" AutomationProperties.Name="{local:Loc TreeBrushSize_B34DE6B5}" />
                        <DockPanel><TextBlock Text="{local:Loc Density_77A283D6}" /><TextBlock x:Name="DensityLabel" HorizontalAlignment="Right" /></DockPanel>
                        <Slider x:Name="DensitySlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OptionsChanged" Margin="0,7,0,14" AutomationProperties.Name="{local:Loc TreeDensity_766BEDF6}" />
                        <DockPanel><TextBlock Text="{local:Loc Spacing_62A822A5}" /><TextBlock x:Name="SpacingLabel" HorizontalAlignment="Right" /></DockPanel>
                        <Slider x:Name="SpacingSlider" Minimum="1" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OptionsChanged" Margin="0,7,0,0" AutomationProperties.Name="{local:Loc TreeSpacing_151636E1}" />
                    </StackPanel>
                </Grid>
            </Grid>
            <StackPanel Grid.Row="2" Margin="0,10,0,0"><TextBlock x:Name="ErrorLabel" Foreground="{DynamicResource ThemeD69D92}" TextWrapping="Wrap" IsVisible="False" /></StackPanel>
            <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="CancelButton" Content="{local:Loc Cancel_19766ED6}" IsCancel="True" /><Button x:Name="ApplyButton" Content="{local:Loc UseTreeBrush_993C06D2}" Theme="{StaticResource PrimaryButton}" IsDefault="True" IsEnabled="False" Click="ApplyClick" /></StackPanel>
                <StackPanel VerticalAlignment="Center"><TextBlock x:Name="SelectionLabel" Foreground="{DynamicResource Muted}" /><TextBlock x:Name="ListStatusLabel" Foreground="{DynamicResource Muted}" IsVisible="False" /></StackPanel>
            </DockPanel>
    </Grid>
</local:EditorWindow>