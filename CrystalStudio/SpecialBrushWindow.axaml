<local:EditorWindow xmlns="https://github.com/avaloniaui" xmlns:local="clr-namespace:CrystalStudio" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CrystalStudio.SpecialBrushWindow" Title="Special Brush" Width="1140" Height="820" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <DataTemplate x:Key="TreeRow">
            <Grid Margin="2" ToolTip.Tip="{Binding File}"><Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource Theme252C38}" CornerRadius="3" Height="48"><Image Source="{Binding Preview.Bitmap}" Stretch="Uniform" Margin="3" /></Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Type}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="TreeSettings" Margin="20">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="12" /><ColumnDefinition Width="200" /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Brush" Foreground="{DynamicResource Muted}" Margin="0,0,0,5" /><ComboBox x:Name="BrushTypeList" SelectedIndex="0" SelectionChanged="BrushTypeChanged" AutomationProperties.Name="Special Brush Type"><ComboBoxItem Content="Tree Brush" Tag="Tree" /><ComboBoxItem Content="Bush Brush" Tag="Bush" /><ComboBoxItem Content="Rock Brush" Tag="Rock" /></ComboBox></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock x:Name="TypeLabel" Text="Tree Type" Foreground="{DynamicResource Muted}" Margin="0,0,0,5" /><ComboBox x:Name="TypeList" SelectionChanged="TypeChanged" AutomationProperties.Name="Object Type" ToolTip.Tip="Tree Type" /></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="Search" Foreground="{DynamicResource Muted}" Margin="0,0,0,5" /><TextBox x:Name="SearchBox" Height="34" Margin="0" Padding="9,5" Tag="Search Trees…" TextChanged="FilterChanged" VerticalContentAlignment="Center" AutomationProperties.Name="Search Trees" /></StackPanel>
                <StackPanel Grid.Column="6"><TextBlock Text="Paint With" Foreground="{DynamicResource Muted}" Margin="0,0,0,5" /><ComboBox x:Name="PaintSourceList" SelectedIndex="0" SelectionChanged="PaintSourceChanged" AutomationProperties.Name="Trees to Paint" ToolTip.Tip="Trees to Paint">
                    <ComboBoxItem Content="Random Trees from This Type" /><ComboBoxItem Content="My Tree List" /><ComboBoxItem Content="Selected Trees" />
                </ComboBox></StackPanel>
            </Grid>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="16" /><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition Width="0.95*" /></Grid.ColumnDefinitions>
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock x:Name="BrowseLabel" Text="Browse Trees" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <Border Grid.Row="1" Background="{DynamicResource Theme151B24}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5">
                        <Grid>
                            <ListBox x:Name="TreeList" ItemTemplate="{StaticResource TreeRow}" SelectionMode="Multiple" SelectionChanged="TreesChanged" DoubleTapped="TreeDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Tree Variants" ToolTip.Tip="Double-Click to Add a Tree. Ctrl-Click to Select Several." />
                            <TextBlock x:Name="EmptyLabel" Text="Loading Trees…" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" IsHitTestVisible="False" Margin="16" />
                        </Grid>
                    </Border>
                    <WrapPanel Grid.Row="2" Margin="0,8,0,0"><Button x:Name="AddTreesButton" Content="Add Selected →" Click="AddTreesClick" /><Button x:Name="AddTypeButton" Content="Add Type →" Click="AddTypeClick" ToolTip.Tip="Add All Trees of This Type" /></WrapPanel>
                </Grid>
                <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock x:Name="CuratedLabel" Text="My Tree List" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <TextBox x:Name="ListNameBox" Grid.Row="1" Text="My trees" Height="32" Padding="8,4" MaxLength="256" VerticalContentAlignment="Center" TextChanged="ListNameChanged" AutomationProperties.Name="Tree List Name" Margin="0,0,0,8" />
                    <Border Grid.Row="2" Background="{DynamicResource Theme151B24}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5"><ListBox x:Name="CuratedList" ItemTemplate="{StaticResource TreeRow}" SelectionMode="Multiple" SelectionChanged="CuratedSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" AutomationProperties.Name="My Curated Trees" /></Border>
                    <Grid Grid.Row="3" Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <WrapPanel><Button x:Name="RemoveTreesButton" Content="Remove" Click="RemoveTreesClick" ToolTip.Tip="Remove Selected Trees" /><Button x:Name="ClearTreesButton" Content="Clear" Click="ClearTreesClick" ToolTip.Tip="Clear My Tree List" /></WrapPanel>
                        <WrapPanel Grid.Row="1"><Button x:Name="SaveTreeListButton" Content="Save List…" Click="SaveTreeListClick" /><Button x:Name="LoadTreeListButton" Content="Load List…" Click="LoadTreeListClick" /></WrapPanel>
                    </Grid>
                </Grid>
                <Grid Grid.Column="4"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10"><TextBlock x:Name="SelectedTreeName" Text="Select a Tree" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="SelectedTreeType" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /></StackPanel>
                    <Border Grid.Row="1" Background="{DynamicResource Theme151B24}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" MinHeight="180">
                        <Grid><Image x:Name="TreePreviewImage" Stretch="Uniform" Margin="14" RenderOptions.BitmapInterpolationMode="None" AutomationProperties.Name="Selected Tree Preview" /><TextBlock x:Name="PreviewPlaceholder" Text="Select a Tree" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
                    </Border>
                    <StackPanel Grid.Row="2" Margin="0,18,0,0">
                        <DockPanel><TextBlock Text="Brush Size" /><TextBlock x:Name="SizeLabel" HorizontalAlignment="Right" /></DockPanel>
                        <Slider x:Name="SizeSlider" Minimum="3" Maximum="31" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="OptionsChanged" Margin="0,7,0,14" AutomationProperties.Name="Tree Brush Size" />
                        <DockPanel><TextBlock Text="Density" /><TextBlock x:Name="DensityLabel" HorizontalAlignment="Right" /></DockPanel>
                        <Slider x:Name="DensitySlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OptionsChanged" Margin="0,7,0,14" AutomationProperties.Name="Tree Density" />
                        <DockPanel><TextBlock Text="Spacing" /><TextBlock x:Name="SpacingLabel" HorizontalAlignment="Right" /></DockPanel>
                        <Slider x:Name="SpacingSlider" Minimum="1" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OptionsChanged" Margin="0,7,0,0" AutomationProperties.Name="Tree Spacing" />
                    </StackPanel>
                </Grid>
            </Grid>
            <StackPanel Grid.Row="2" Margin="0,10,0,0"><TextBlock x:Name="ErrorLabel" Foreground="{DynamicResource ThemeD69D92}" TextWrapping="Wrap" IsVisible="False" /></StackPanel>
            <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="CancelButton" Content="Cancel" IsCancel="True" /><Button x:Name="ApplyButton" Content="Use Tree Brush" Theme="{StaticResource PrimaryButton}" IsDefault="True" IsEnabled="False" Click="ApplyClick" /></StackPanel>
                <StackPanel VerticalAlignment="Center"><TextBlock x:Name="SelectionLabel" Foreground="{DynamicResource Muted}" /><TextBlock x:Name="ListStatusLabel" Foreground="{DynamicResource Muted}" IsVisible="False" /></StackPanel>
            </DockPanel>
    </Grid>
</local:EditorWindow>