<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CrystalStudio</AssemblyName>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.4" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CrystalStudio.Tests" />
    <EmbeddedResource Include="DefaultWorkspace.json" />
    <EmbeddedResource Include="PreviewLights/*.png" />
    <Content Include="../Objects/**/*.X" Link="Objects/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../catalogue/previews/**/*.png" Link="catalogue/previews/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../catalogue/palette.json" Condition="Exists('../catalogue/palette.json')" Link="catalogue/palette.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../catalogue/towns.json" Link="catalogue/towns.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../catalogue/province-decoration-ground.json" Link="catalogue/province-decoration-ground.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../catalogue/terrain.json" Link="catalogue/terrain.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../catalogue/water.json" Link="catalogue/water.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../catalogue/island/*" Link="catalogue/island/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../catalogue/river-artwork.json" Link="catalogue/river-artwork.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../catalogue/river-coast-layouts/*" Exclude="../catalogue/river-coast-layouts/*.md" Link="catalogue/river-coast-layouts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Complete river courses are offline comparison fixtures, not generator assets. -->
    <Content Include="../catalogue/river-coast-layouts/chains/northwest-corner.*" Link="catalogue/river-coast-layouts/modules/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../catalogue/river-coast-layouts/modules/*" Link="catalogue/river-coast-layouts/modules/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../catalogue/river-coast-layouts/edges/*.X" Link="catalogue/river-coast-layouts/edges/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../catalogue/river-coast-layouts/forks/*" Link="catalogue/river-coast-layouts/forks/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../catalogue/river-coast-layouts/caps/*" Link="catalogue/river-coast-layouts/caps/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../catalogue/river-coast-layouts/bridges/*" Link="catalogue/river-coast-layouts/bridges/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../catalogue/river-coast-layouts/winding/*" Link="catalogue/river-coast-layouts/winding/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../catalogue/river-coast-layouts/variants/*" Link="catalogue/river-coast-layouts/variants/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../catalogue/walls.json" Link="catalogue/walls.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../catalogue/walls/**/walls.json" Link="catalogue/walls/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="@(Content)" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
